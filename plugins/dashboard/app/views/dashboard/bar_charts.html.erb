<% content_for :header_tags do %>
  <%# Ensure Choices.js JS and CSS are loaded. Assuming they are in your plugin's assets. %>
  <%= javascript_include_tag 'chart.min.js', :plugin => 'dashboard' %>
  <%= javascript_include_tag 'choices.min.js', :plugin => 'dashboard' %>
  <%= stylesheet_link_tag 'choices.min.css', :plugin => 'dashboard' %>
  <%= stylesheet_link_tag 'scaffolds', :plugin => 'dashboard' %>
<% end %>

<div class="contextual">
  <%= link_to 'View Pie Charts', pie_charts_dashboard_index_path, class: 'icon icon-stats' %>
</div>

<div class="dashboard-header" style="text-align: left; margin-bottom: 20px; padding: 15px">
  <h2 style="margin: 0 0 5px 0; font-size: 1.8em; color: #333;">Dashboard</h2>
</div>

<%= form_tag bar_charts_dashboard_index_path, method: :get, id: 'dashboard_filters_form', class: 'filter-form' do %>
  <div class="filters-container" style="display: flex; flex-wrap: wrap; gap: 18px 28px; align-items: flex-end; padding: 10px 14px 6px 14px; border: 1px solid #eee; background: #fafbfc; margin-bottom: 16px; border-radius: 7px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); width: 1200px; max-width: 100%; margin-left: auto; margin-right: auto;">
    <div class="filter-group" style="min-width: 220px; flex: 1 1 220px;">
      <label for="custom_query_id" style="display: block; font-weight: 600; margin-bottom: 3px; letter-spacing: 0.01em;">Custom Query</label>
      <%= select_tag 'custom_query_id',
          options_for_select(@custom_queries.map { |q| [q.name, q.id] }, @selected_custom_query_id),
          include_blank: 'Select a custom query...',
          class: 'choices-select-single', style: 'width: 100%; padding: 6px 10px; border: none; background: #fff; border-radius: 5px; box-shadow: 0 1px 2px rgba(0,0,0,0.03); font-size: 1em;' %>
    </div>

    <div class="filter-group" style="min-width: 160px; flex: 0 1 160px;">
      <label style="display: block; font-weight: 600; margin-bottom: 3px; letter-spacing: 0.01em;">Status</label>
      <div class="checkbox-group" style="display: flex; gap: 10px; align-items: center; margin-top: 0;">
        <%= hidden_field_tag 'default_open_statuses', '0' %>
        <%= check_box_tag 'default_open_statuses', '1',
              @selected_status_ids.any? &&
              (@selected_status_ids - @open_statuses.map(&:id)).empty?,
              id: 'default_open_statuses_checkbox' %>
        <label for="default_open_statuses_checkbox" style="font-weight: 400; margin: 0 8px 0 2px;">Open</label>

        <%= hidden_field_tag 'default_closed_statuses', '0' %>
        <%= check_box_tag 'default_closed_statuses', '1',
              @selected_status_ids.any? &&
              (@selected_status_ids - @closed_statuses.map(&:id)).empty?,
              id: 'default_closed_statuses_checkbox' %>
        <label for="default_closed_statuses_checkbox" style="font-weight: 400; margin: 0 0 0 2px;">Closed</label>
      </div>
    </div>

    <div class="filter-actions" style="flex: 0 1 180px; display: flex; justify-content: flex-end; gap: 8px; margin-top: 0;">
      <%= submit_tag 'Apply Filter', class: 'apply-button', style: 'padding: 7px 18px; background-color:  #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; font-size: 1em; font-weight: 500;' %>
      <%= link_to 'Clear', bar_charts_dashboard_index_path, class: 'clear-button', style: 'padding: 7px 18px; background-color: #f5f5f5; color: #333; border: 1px solid #ddd; border-radius: 5px; text-decoration: none; font-size: 1em;' %>
    </div>
  </div>
<% end %>

<% if @show_bar_charts %>
  <div class="charts-section" style="margin-bottom: 30px; width: 100%; overflow-x: auto;">
    <div id="barChartsContainer" style="width: 100%; min-width: 1100px;">
      <div class="chart-card" style="border: 2px solid #888; background-color: #fff; padding: 20px; box-shadow: 0 1px 2px rgba(0,0,0,0.04); width: 95%; max-width: 1400px; margin: 0 auto; border-radius: 8px; min-height: 800px;">
        <div class="chart-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px solid #eee;">
          <h3 style="margin: 0; font-size: 1.2em; color: #333;">Issues by Assignee</h3>
          <span class="chart-count" style="background-color: #e6f7ff; color: #007bff; padding: 3px 8px; border-radius: 3px; font-size: 0.8em;"><%= @assignee_bar_chart_data&.sum { |item| item[:value] } || 0 %> total issues</span>
        </div>
        <div class="chart-content" style="position: relative; width: 100%; height: auto; min-height: 700px; padding: 10px;">
          <canvas id="assigneeBarChart" style="width: 100% !important; height: auto !important; display: block;"></canvas>
        </div>
      </div>
    </div>
  </div>

<% else %>
  <div class="empty-state" style="text-align: center; padding: 30px 20px; border: 1px solid #ddd; background-color: #fff;">
    <h3 style="margin: 0 0 10px 0; font-size: 1.3em; color: #555;">No Data to Display</h3>
    <p style="margin: 0; font-size: 0.9em; color: #777;">Please select filters, or a custom query, and click "Apply Filter" to view bar chart data.</p>
  </div>
<% end %>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Inject data from controller
  const assigneeBarChartData = <%= raw @assignee_bar_chart_data.to_json %>;

  // Initialize Choices.js for multi-selects
  const choicesMultiSelects = document.querySelectorAll('.choices-select');
  choicesMultiSelects.forEach(function(select) {
    new Choices(select, {
      removeItemButton: true,
      searchEnabled: true,
      searchChoices: true,
      placeholder: true,
      placeholderValue: 'Select options...',
      shouldSort: false
    });
  });

  // Initialize Choices.js for single select
  const choicesSingleSelects = document.querySelectorAll('.choices-select-single');
  choicesSingleSelects.forEach(function(select) {
    new Choices(select, {
      removeItemButton: false,
      searchEnabled: true,
      searchChoices: true,
      placeholder: true,
      placeholderValue: 'Select a custom query...',
      shouldSort: false
    });
  });

  // Chart.js helper functions
  function getChartColors(count) {
    const colors = [
      '#6699CC', '#99CC99', '#CC9966', '#CC6666',
      '#9966CC', '#66CC99', '#CC6699', '#669966'
    ];
    return Array.from({ length: count }, (_, i) => colors[i % colors.length]);
  }

  function createChart(canvasId, type, data, title, options = {}) {
    try {
      const canvas = document.getElementById(canvasId);
      if (!canvas) {
        console.error(`Canvas with ID ${canvasId} not found`);
        return;
      }

      // Destroy existing chart instance
      if (canvas.chart) {
        canvas.chart.destroy();
      }

      // --- AGGREGATION LOGIC STARTS HERE ---
      const aggregatedDataMap = data.reduce((acc, item) => {
        acc[item.name] = (acc[item.name] || 0) + item.value;
        return acc;
      }, {});

      const processedData = Object.keys(aggregatedDataMap).map(name => ({
        name: name,
        value: aggregatedDataMap[name]
      }));
      // --- AGGREGATION LOGIC ENDS HERE ---

      // Handle empty data
      if (!processedData || processedData.length === 0) {
        const ctx = canvas.getContext('2d');
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#999';
        ctx.font = '14px sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('No data available', canvas.width / 2, canvas.height / 2);
        return;
      }

      const ctx = canvas.getContext('2d');
      
      // Calculate proper dimensions
      const barHeight = 20; // Fixed bar height
      const barSpacing = 7; // Fixed spacing between bars
      const chartPadding = 100; // Padding for labels and axes
      const calculatedHeight = Math.max(600, (processedData.length * (barHeight + barSpacing)) + chartPadding);
      
      // Set container height first
      const container = canvas.parentElement;
      const containerWidth = container ? container.offsetWidth - 40 : 1200;
      
      // Force container height
      container.style.height = calculatedHeight + 'px';
      container.style.minHeight = calculatedHeight + 'px';
      
      // Set canvas dimensions - do this BEFORE creating chart
      canvas.style.width = '100%';
      canvas.style.height = calculatedHeight + 'px';
      canvas.width = containerWidth;
      canvas.height = calculatedHeight;

      const labels = processedData.map(item => item.name);
      const values = processedData.map(item => item.value);
      const barColor = '#6699CC'; // Use a single color for all bars

      const chartConfig = {
        type: type,
        data: {
          labels: labels,
          datasets: [{
            label: 'Issues',
            data: values,
            backgroundColor: barColor,
            borderColor: barColor,
            borderWidth: 1,
            borderRadius: 4,
            borderSkipped: false,
            // Fixed bar thickness - these settings ensure consistent bar size
            barThickness: barHeight, // Fixed bar thickness
            maxBarThickness: barHeight, // Maximum bar thickness
            categoryPercentage: 0.9, // How much of the category width to use
            barPercentage: 0.8 // How much of the bar category to use
          }]
        },
        options: {
          responsive: false, // Disable responsive behavior
          maintainAspectRatio: false, // Disable aspect ratio maintenance
          width: containerWidth,
          height: calculatedHeight,
          layout: {
            padding: {
              left: 20,
              right: 20,
              top: 20,
              bottom: 20
            }
          },
          plugins: {
            legend: {
              display: false,
            },
            title: {
              display: false,
            },
            tooltip: {
              backgroundColor: 'rgba(0, 0, 0, 0.8)',
              titleColor: '#fff',
              bodyColor: '#fff',
              borderColor: '#666',
              borderWidth: 1,
              cornerRadius: 4,
              titleFont: {
                size: 14,
                weight: 'bold'
              },
              bodyFont: {
                size: 13
              },
              callbacks: {
                label: function(context) {
                  return `${context.label}: ${context.parsed.x} issues`;
                }
              }
            }
          },
          scales: {
            x: {
              beginAtZero: true,
              grid: {
                color: '#e0e0e0',
                drawBorder: false,
                lineWidth: 1
              },
              ticks: {
                precision: 0,
                color: '#666',
                font: {
                  size: 12
                },
                padding: 8
              },
              title: {
                display: true,
                text: 'Number of Issues',
                color: '#333',
                font: {
                  size: 14,
                  weight: 'bold'
                },
                padding: 15
              }
            },
            y: {
              grid: {
                display: false,
              },
              ticks: {
                color: '#333',
                font: {
                  size: 13,
                  weight: '500'
                },
                callback: function(value, index, ticks) {
                  const label = labels[index] || '';
                  // Truncate long labels but show more characters
                  return label.length > 30 ? label.slice(0, 28) + '...' : label;
                },
                maxWidth: 300, // More space for labels
                autoSkip: false,
                maxRotation: 0,
                minRotation: 0,
                padding: 10
              }
            }
          },
          indexAxis: 'y', // Horizontal bars
          elements: {
            bar: {
              borderRadius: 4
            }
          },
          ...options
        }
      };

      canvas.chart = new Chart(ctx, chartConfig);
      
      // Force canvas size after chart creation if Chart.js overwrote it
      setTimeout(() => {
        if (canvas.style.height !== calculatedHeight + 'px') {
          canvas.style.height = calculatedHeight + 'px';
          canvas.height = calculatedHeight;
          canvas.chart.resize();
        }
      }, 100);
      
      console.log(`Successfully created ${title} chart with ${processedData.length} items, height: ${calculatedHeight}px`);
      
      // Update container height to match chart
      const chartContainer = canvas.closest('.chart-content');
      if (chartContainer) {
        chartContainer.style.height = (calculatedHeight + 40) + 'px';
        chartContainer.style.minHeight = (calculatedHeight + 40) + 'px';
      }
      
    } catch (error) {
      console.error(`Error creating ${title} chart:`, error);
    }
  }

  // Initialize date pickers if Redmine's datepicker function exists
  if (typeof datepickerExists === 'function') {
    $('#start_date').each(function() {
      datepickerExists(this);
    });
    $('#due_date').each(function() {
      datepickerExists(this);
    });
  }

  // Render charts
  if (typeof Chart !== 'undefined') {
    createChart('assigneeBarChart', 'bar', assigneeBarChartData, 'Issues by Assignee');
  } else {
    console.error('Chart.js library not loaded');
  }
});
</script>