<%- @settings ||= {} %>

<style>
/* ── layout ──────────────────────────────────────────────────────────────── */
.pcu-box          { border:1px solid #ddd; border-radius:4px; margin-bottom:20px; }
.pcu-box-head     { padding:9px 14px; background:#f5f5f5; border-bottom:1px solid #ddd;
                    font-weight:bold; font-size:13px; color:#333; }
.pcu-box-body     { padding:14px 16px; }
.pcu-setting      { margin-bottom:14px; }
.pcu-setting:last-child { margin-bottom:0; }
.pcu-setting label      { font-weight:bold; display:block; margin-bottom:4px; font-size:13px; }
.pcu-setting label.inline { display:inline; font-weight:normal; }
.pcu-hint         { color:#777; font-size:12px; margin-top:3px; }

/* ── tracker accordion ───────────────────────────────────────────────────── */
.pcu-tracker      { border:1px solid #ddd; border-radius:4px; margin-bottom:10px; }
.pcu-tracker-hd   { padding:9px 14px; background:#fafafa; cursor:pointer;
                    display:flex; justify-content:space-between; align-items:center;
                    font-size:13px; font-weight:bold; user-select:none; }
.pcu-tracker-hd:hover { background:#eef5fb; }
.pcu-tracker-bd   { padding:14px 16px; display:none; border-top:1px solid #eee; }
.pcu-tracker-bd.open { display:block; }

/* ── selected fields chips ───────────────────────────────────────────────── */
.pcu-chips        { display:flex; flex-wrap:wrap; gap:7px; min-height:36px;
                    padding:7px; border:1px dashed #ccc; border-radius:4px;
                    background:#fff; margin-bottom:12px; align-items:center; }
.pcu-chip         { display:inline-flex; align-items:center; gap:5px;
                    background:#e3f2fd; border:1px solid #90caf9;
                    border-radius:14px; padding:3px 10px 3px 12px;
                    font-size:12px; color:#1565c0; }
.pcu-chip .pcu-chip-req  { font-size:10px; background:#f44336; color:#fff;
                            border-radius:3px; padding:1px 4px; }
.pcu-chip .pcu-chip-opt  { font-size:10px; background:#9e9e9e; color:#fff;
                            border-radius:3px; padding:1px 4px; }
.pcu-chip-remove  { background:none; border:none; cursor:pointer; font-size:15px;
                    line-height:1; color:#1565c0; padding:0; margin-left:2px; }
.pcu-chip-remove:hover { color:#c62828; }
.pcu-chip-move    { background:none; border:none; cursor:pointer; font-size:12px;
                    line-height:1; color:#888; padding:0 1px; margin:0; }
.pcu-chip-move:hover { color:#333; }
.pcu-drag-handle  { cursor:grab; color:#aaa; font-size:13px; margin-right:3px;
                    user-select:none; line-height:1; }
.pcu-drag-handle:active { cursor:grabbing; }
.pcu-chip[draggable=true] { cursor:default; }
.pcu-chip.pcu-dragging    { opacity:0.35; }
.pcu-chip.pcu-drag-over   { outline:2px dashed #1976D2; outline-offset:2px; }
.pcu-chips-empty  { color:#aaa; font-size:12px; font-style:italic; padding:4px 2px; }

/* ── add-field row ───────────────────────────────────────────────────────── */
.pcu-add-row      { display:flex; gap:8px; align-items:center; }
.pcu-add-row select { flex:1; padding:6px 8px; font-size:13px;
                      border:1px solid #ccc; border-radius:3px; }
.pcu-add-btn      { padding:6px 14px; font-size:13px; background:#4caf50; color:#fff;
                    border:none; border-radius:3px; cursor:pointer; white-space:nowrap; }
.pcu-add-btn:hover { background:#388e3c; }
.pcu-add-btn:disabled { background:#aaa; cursor:default; }

/* ── misc ────────────────────────────────────────────────────────────────── */
.pcu-no-trackers  { color:#aaa; font-size:13px; font-style:italic; }
.pcu-count-badge  { font-size:11px; background:#4c96c4; color:#fff; border-radius:10px;
                    padding:1px 7px; margin-left:6px; font-weight:normal; }
.pcu-arrow        { font-size:11px; color:#888; }
</style>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 1 – General
    ═══════════════════════════════════════════════════════════════════════════ %>
<div class="pcu-box">
  <div class="pcu-box-head">General</div>
  <div class="pcu-box-body">

    <div class="pcu-setting">
      <label class="inline">
        <%= check_box_tag 'settings[enabled]', '1', @settings['enabled'] != '0' %>
        Enable Parent-to-Child Update plugin
      </label>
    </div>

    <div class="pcu-setting">
      <label class="inline">
        <%= check_box_tag 'settings[enable_logging]', '1', @settings['enable_logging'] == '1' %>
        Enable debug logging (Rails log)
      </label>
    </div>

    <div class="pcu-setting">
      <label>Popup header gradient colors</label>
      <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
        <%
          raw_colors   = (@settings['popup_header_color'] || '#eff6ff,#dbeafe').split(',').map(&:strip)
          hdr_color1   = raw_colors[0].presence || '#eff6ff'
          hdr_color2   = raw_colors[1].presence || '#dbeafe'
        %>
        <div style="display:flex;align-items:center;gap:6px;">
          <label class="inline" style="font-weight:normal;font-size:12px;">Start&nbsp;color</label>
          <input type="color" id="pcu-hdr-c1" value="<%= hdr_color1 %>"
                 oninput="pcuUpdateHeaderPreview()"
                 style="width:38px;height:28px;padding:1px;border:1px solid #ccc;border-radius:4px;cursor:pointer;">
        </div>
        <div style="display:flex;align-items:center;gap:6px;">
          <label class="inline" style="font-weight:normal;font-size:12px;">End&nbsp;color</label>
          <input type="color" id="pcu-hdr-c2" value="<%= hdr_color2 %>"
                 oninput="pcuUpdateHeaderPreview()"
                 style="width:38px;height:28px;padding:1px;border:1px solid #ccc;border-radius:4px;cursor:pointer;">
        </div>
        <div id="pcu-hdr-preview"
             style="height:32px;width:220px;border-radius:6px;border:1px solid #ddd;
                    background:linear-gradient(135deg,<%= hdr_color1 %>,<%= hdr_color2 %>);
                    display:flex;align-items:center;padding:0 12px;font-size:13px;
                    font-weight:700;color:#1e3a8a;">
          Create Child Tracker
        </div>
        <button type="button" onclick="pcuResetHeaderColor()"
                style="padding:4px 10px;font-size:12px;background:#9e9e9e;color:#fff;
                       border:none;border-radius:3px;cursor:pointer;">Reset to default</button>
      </div>
      <%# Hidden field that carries the combined value on form submit %>
      <%= hidden_field_tag 'settings[popup_header_color]',
            "#{hdr_color1},#{hdr_color2}", id: 'pcu-hdr-value' %>
      <p class="pcu-hint">Choose the gradient start and end color for the popup header bar.</p>
    </div>

  </div>
</div>

<script>
function pcuUpdateHeaderPreview() {
  var c1 = document.getElementById('pcu-hdr-c1').value;
  var c2 = document.getElementById('pcu-hdr-c2').value;
  document.getElementById('pcu-hdr-preview').style.background =
    'linear-gradient(135deg,' + c1 + ',' + c2 + ')';
  document.getElementById('pcu-hdr-value').value = c1 + ',' + c2;
}
function pcuResetHeaderColor() {
  document.getElementById('pcu-hdr-c1').value = '#eff6ff';
  document.getElementById('pcu-hdr-c2').value = '#dbeafe';
  pcuUpdateHeaderPreview();
}
</script>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 2 – Field Replication
    ═══════════════════════════════════════════════════════════════════════════ %>
<div class="pcu-box">
  <div class="pcu-box-head">Field Replication</div>
  <div class="pcu-box-body">

    <div class="pcu-setting">
      <label class="inline">
        <%= check_box_tag 'settings[auto_replicate_fields]', '1',
              @settings['auto_replicate_fields'] != '0' %>
        Automatically replicate parent fields to child on creation
      </label>
    </div>

    <div class="pcu-setting">
      <label>Fields to replicate (comma-separated key names)</label>
      <%= text_area_tag 'settings[replicated_fields]',
            @settings['replicated_fields'] ||
            'priority,assigned_to,category,fixed_version,description,due_date,start_date,estimated_hours,custom_fields',
            rows: 3, style: 'width:100%;max-width:560px;font-size:13px;padding:6px;' %>
      <p class="pcu-hint">
        Valid keys: <code>priority, assigned_to, category, fixed_version, description,
        due_date, start_date, estimated_hours, custom_fields, author, subject</code>
      </p>
    </div>

    <div class="pcu-setting">
      <label class="inline">
        <%= check_box_tag 'settings[append_required_fields]', '1',
              @settings['append_required_fields'] != '0' %>
        Also copy required custom fields from parent even when not in the list above
      </label>
    </div>

  </div>
</div>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 3 – Additional Child Issues
    ═══════════════════════════════════════════════════════════════════════════ %>
<div class="pcu-box">
  <div class="pcu-box-head">Additional Child Issues</div>
  <div class="pcu-box-body">

    <div class="pcu-setting">
      <label class="inline">
        <%= check_box_tag 'settings[create_additional_children]', '1',
              @settings['create_additional_children'] != '0' %>
        Allow creating additional child issues alongside the primary child
      </label>
    </div>

    <div class="pcu-setting">
      <label>Additional child tracker names (comma-separated)</label>
      <%= text_field_tag 'settings[additional_child_trackers]',
            @settings['additional_child_trackers'] || 'Development Task,Testing Task',
            style: 'width:100%;max-width:420px;padding:6px;font-size:13px;' %>
    </div>

  </div>
</div>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 3b – Child issue type dropdown items (per parent tracker)
    ═══════════════════════════════════════════════════════════════════════════ %>
<div class="pcu-box">
  <div class="pcu-box-head">Child issue type dropdown items</div>
  <div class="pcu-box-body">
    <p style="margin:0 0 12px;font-size:13px;color:#555;">
      For each <strong>parent tracker</strong>, specify which child issue types appear in the
      <em>Create Child Issue</em> popup dropdown. Leave blank to show all available child trackers.
    </p>

    <% child_trackers_map = (@settings['popup_child_trackers_by_parent'] || {}).transform_keys(&:to_s) %>

    <table style="width:100%;border-collapse:collapse;font-size:13px;">
      <thead>
        <tr style="background:#f5f5f5;">
          <th style="text-align:left;padding:7px 10px;border:1px solid #ddd;width:220px;color:#444;">Parent Tracker</th>
          <th style="text-align:left;padding:7px 10px;border:1px solid #ddd;color:#444;">
            Child issue type options
            <span style="font-weight:normal;color:#888;font-size:11px;">(comma-separated, case-insensitive)</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <% Tracker.order(:name).each do |tracker| %>
          <tr>
            <td style="padding:6px 10px;border:1px solid #eee;color:#333;font-weight:bold;">
              <%= tracker.name %>
            </td>
            <td style="padding:4px 8px;border:1px solid #eee;">
              <%= text_field_tag "settings[popup_child_trackers_by_parent][#{tracker.id}]",
                    child_trackers_map[tracker.id.to_s].to_s,
                    style: 'width:100%;padding:5px 7px;font-size:13px;border:1px solid #ccc;border-radius:3px;box-sizing:border-box;',
                    placeholder: 'e.g. User Story, Task  (blank = show all)' %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p class="pcu-hint" style="margin-top:8px;">
      Example: for <strong>Change Request</strong> enter <code>User Story, Task</code> &mdash;
      for <strong>User Story</strong> enter <code>Task</code>.
    </p>
  </div>
</div>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 4 – Popup Fields Per Child Tracker
    ═══════════════════════════════════════════════════════════════════════════ %>
<%
  # Standard Redmine fields in the order they appear in the Redmine issue form.
  # core_key matches what tracker.core_fields returns so we can filter per tracker.
  # Names use Redmine's own i18n labels for exact match with the UI.
  pcu_all_std = [
    { key: 'status_id',        core_key: 'status_id',        name: l(:field_status)          },
    { key: 'priority_id',      core_key: 'priority_id',      name: l(:field_priority)        },
    { key: 'assigned_to_id',   core_key: 'assigned_to_id',   name: l(:field_assigned_to)     },
    { key: 'author_id',        core_key: 'author_id',        name: l(:field_author)          },
    { key: 'category_id',      core_key: 'category_id',      name: l(:field_category)        },
    { key: 'fixed_version_id', core_key: 'fixed_version_id', name: l(:field_fixed_version)   },
    { key: 'start_date',       core_key: 'start_date',       name: l(:field_start_date)      },
    { key: 'due_date',         core_key: 'due_date',         name: l(:field_due_date)        },
    { key: 'estimated_hours',  core_key: 'estimated_hours',  name: l(:field_estimated_hours) },
    { key: 'done_ratio',       core_key: 'done_ratio',       name: l(:field_done_ratio)      },
    { key: 'description',      core_key: 'description',      name: l(:field_description)     },
  ]

  popup_cfg    = (@settings['tracker_popup_fields'] || {}).transform_keys(&:to_s)
  all_trackers = Tracker.order(:position, :name)
%>
<div class="pcu-box">
  <div class="pcu-box-head">Popup Fields Per Child Tracker</div>
  <div class="pcu-box-body">

    <p style="margin:0 0 14px;color:#555;font-size:13px;">
      For each child tracker, choose which fields appear in the <em>Create Child Tracker</em> popup.
      Fields default to <strong>all applicable fields</strong> for that tracker (matching the Redmine issue form).
      Use <strong>+ Add</strong> to add a field, <strong>×</strong> to remove, <strong>↑ ↓</strong> to reorder, or the
      <strong>Select All / Clear All</strong> buttons.
    </p>

    <div class="pcu-setting" style="margin-bottom:16px;padding-bottom:16px;border-bottom:1px solid #eee;">
      <label>Excluded fields (by name)</label>
      <%= text_field_tag 'settings[popup_excluded_fields]',
            @settings['popup_excluded_fields'] || 'Release Details',
            style: 'width:100%;max-width:520px;padding:6px;font-size:13px;' %>
      <p class="pcu-hint">
        Comma-separated field names to hide from popup across all trackers (e.g. <code>Release Details</code>).
        Applies to both standard and custom fields matched by name (case-insensitive).
      </p>
    </div>

    <% if all_trackers.empty? %>
      <p class="pcu-no-trackers">No trackers found in this Redmine instance.</p>
    <% else %>
      <% all_trackers.each do |tracker| %>
        <%
          tid = tracker.id

          # Custom fields ordered by position (same order as Redmine issue form)
          all_cfs = tracker.custom_fields.order(:position, :name)

          # Standard fields enabled for this tracker (via tracker.core_fields if available)
          tracker_core = tracker.respond_to?(:core_fields) ? Array(tracker.core_fields).map(&:to_s) : []
          pcu_std = pcu_all_std.select { |f|
            # these fields are always available regardless of tracker.core_fields
            %w[status_id priority_id assigned_to_id author_id description].include?(f[:core_key]) ||
            tracker_core.include?(f[:core_key])
          }

          # Saved config for this tracker
          sel_ids = Array(popup_cfg[tid.to_s]).map(&:to_s).uniq
          never_configured = sel_ids.empty?

          # If never configured, auto-select ALL fields for this tracker
          if never_configured
            sel_std_keys = pcu_std.map { |f| f[:key] }
            sel_cf_ids   = all_cfs.map  { |cf| cf.id.to_s }
          else
            sel_std_keys = sel_ids.select { |v| v.start_with?('std_') }.map { |v| v.sub('std_', '') }
            sel_cf_ids   = sel_ids.reject { |v| v.start_with?('std_') }.map(&:to_s)
          end

          sel_std   = pcu_std.select  { |f|  sel_std_keys.include?(f[:key]) }
          avail_std = pcu_std.reject   { |f|  sel_std_keys.include?(f[:key]) }
          sel_cfs   = all_cfs.select  { |cf| sel_cf_ids.include?(cf.id.to_s) }
          avail_cfs = all_cfs.reject   { |cf| sel_cf_ids.include?(cf.id.to_s) }

          total_sel   = sel_std.size + sel_cfs.size
          total_avail = pcu_std.size + all_cfs.size
        %>

        <div class="pcu-tracker" id="pcu-tracker-<%= tid %>">

          <%# ── accordion header ─────────────────────────────────────────── %>
          <div class="pcu-tracker-hd" onclick="pcuToggle(<%= tid %>)">
            <span>
              <%= tracker.name %>
              <span class="pcu-count-badge" id="pcu-count-<%= tid %>"><%= total_sel %></span>
              <span style="color:#888;font-weight:normal;font-size:11px;">
                / <%= total_avail %> field<%= total_avail == 1 ? '' : 's' %> in popup
              </span>
            </span>
            <span class="pcu-arrow" id="pcu-arrow-<%= tid %>">▼</span>
          </div>

          <%# ── accordion body ───────────────────────────────────────────── %>
          <div class="pcu-tracker-bd" id="pcu-body-<%= tid %>">

            <%# Hidden checkboxes — wrapped in a container so pcuMoveChip can reorder them to match chip order %>
            <div id="pcu-cb-container-<%= tid %>" style="display:none">

              <%# Standard fields first, then custom fields (Redmine form order for defaults) %>
              <% pcu_std.each do |sf| %>
                <%= check_box_tag "settings[tracker_popup_fields][#{tid}][]",
                      "std_#{sf[:key]}",
                      sel_std_keys.include?(sf[:key]),
                      id:    "pcu-cb-#{tid}-std_#{sf[:key]}",
                      class: 'pcu-hidden-cb',
                      data:  { tid: tid, fid: "std_#{sf[:key]}", name: sf[:name], required: '0', ftype: 'std' } %>
              <% end %>

              <% all_cfs.each do |cf| %>
                <%= check_box_tag "settings[tracker_popup_fields][#{tid}][]",
                      cf.id.to_s,
                      sel_cf_ids.include?(cf.id.to_s),
                      id:    "pcu-cb-#{tid}-cf_#{cf.id}",
                      class: 'pcu-hidden-cb',
                      data:  { tid: tid, fid: "cf_#{cf.id}", name: cf.name, required: cf.is_required ? '1' : '0', ftype: 'cf' } %>
              <% end %>

            </div>

            <%# Action buttons %>
            <div style="display:flex;gap:8px;margin-bottom:10px;align-items:center;">
              <span style="font-size:12px;color:#555;font-weight:bold;">Fields shown in popup:</span>
              <button type="button" class="pcu-add-btn" style="padding:4px 10px;font-size:12px;background:#1976D2;"
                      onclick="pcuSelectAll(<%= tid %>)">Select All</button>
              <button type="button" class="pcu-add-btn" style="padding:4px 10px;font-size:12px;background:#9e9e9e;"
                      onclick="pcuClearAll(<%= tid %>)">Clear All</button>
            </div>

            <%# Selected fields chip list — in Redmine form order %>
            <div class="pcu-chips" id="pcu-chips-<%= tid %>">
              <% if total_sel == 0 %>
                <span class="pcu-chips-empty" id="pcu-empty-<%= tid %>">
                  No fields selected — use the dropdown below or click Select All.
                </span>
              <% end %>
              <% sel_std.each do |sf| %>
                <span class="pcu-chip" id="pcu-chip-<%= tid %>-std_<%= sf[:key] %>"
                      draggable="true" data-fid="std_<%= sf[:key] %>" data-tid="<%= tid %>">
                  <span class="pcu-drag-handle" title="Drag to reorder" draggable="false">&#8942;</span>
                  <%= sf[:name] %>
                  <span style="font-size:10px;background:#1976D2;color:#fff;border-radius:3px;padding:1px 4px;margin-left:4px;" draggable="false">standard</span>
                  <button type="button" class="pcu-chip-remove" title="Remove" draggable="false"
                          onclick="pcuRemove(<%= tid.inspect %>, 'std_<%= sf[:key] %>')">×</button>
                </span>
              <% end %>
              <% sel_cfs.each do |cf| %>
                <span class="pcu-chip" id="pcu-chip-<%= tid %>-cf_<%= cf.id %>"
                      draggable="true" data-fid="cf_<%= cf.id %>" data-tid="<%= tid %>">
                  <span class="pcu-drag-handle" title="Drag to reorder" draggable="false">&#8942;</span>
                  <%= cf.name %>
                  <% if cf.is_required %>
                    <span class="pcu-chip-req" draggable="false">required</span>
                  <% else %>
                    <span class="pcu-chip-opt" draggable="false">optional</span>
                  <% end %>
                  <button type="button" class="pcu-chip-remove" title="Remove" draggable="false"
                          onclick="pcuRemove(<%= tid.inspect %>, 'cf_<%= cf.id %>')">×</button>
                </span>
              <% end %>
            </div>

            <%# Add-field dropdown — shows only fields not yet selected %>
            <div class="pcu-add-row" style="margin-top:10px;">
              <select id="pcu-sel-<%= tid %>">
                <option value="">— select a field to add —</option>
                <% if avail_std.any? %>
                  <optgroup label="Standard Redmine Fields">
                    <% avail_std.each do |sf| %>
                      <option value="std_<%= sf[:key] %>"
                              data-name="<%= sf[:name] %>"
                              data-required="0"
                              data-fid="std_<%= sf[:key] %>">
                        <%= sf[:name] %>
                      </option>
                    <% end %>
                  </optgroup>
                <% end %>
                <% if avail_cfs.any? %>
                  <optgroup label="Custom Fields">
                    <% avail_cfs.each do |cf| %>
                      <option value="cf_<%= cf.id %>"
                              data-name="<%= cf.name %>"
                              data-required="<%= cf.is_required ? '1' : '0' %>"
                              data-fid="cf_<%= cf.id %>">
                        <%= cf.name %> (<%= cf.is_required ? 'required' : 'optional' %>)
                      </option>
                    <% end %>
                  </optgroup>
                <% end %>
              </select>
              <button type="button" class="pcu-add-btn" onclick="pcuAdd(<%= tid %>)">+ Add</button>
            </div>
            <p class="pcu-hint" style="margin-top:6px;">
              Field names and order match the Redmine issue form for this tracker.
              New custom fields added to this tracker appear here automatically.
            </p>

          </div><%# /pcu-tracker-bd %>
        </div><%# /pcu-tracker %>
      <% end %>
    <% end %>

  </div><%# /pcu-box-body %>
</div><%# /pcu-box %>

<script>
/* ── Accordion ──────────────────────────────────────────────────────────── */
function pcuToggle(tid) {
  var body  = document.getElementById('pcu-body-'  + tid);
  var arrow = document.getElementById('pcu-arrow-' + tid);
  if (body.classList.contains('open')) {
    body.classList.remove('open');
    arrow.textContent = '▼';
  } else {
    body.classList.add('open');
    arrow.textContent = '▲';
  }
}

/* ── Add field ──────────────────────────────────────────────────────────── */
/* fid is either "std_<key>" for standard fields or "cf_<id>" for custom fields */
function pcuAdd(tid) {
  var sel   = document.getElementById('pcu-sel-' + tid);
  var fid   = sel.value;  /* e.g. "std_estimated_hours" or "cf_42" */
  if (!fid) { sel.focus(); return; }

  var opt     = sel.options[sel.selectedIndex];
  var fName   = opt.dataset.name || opt.text;
  var isReq   = opt.dataset.required === '1';
  var isStd   = fid.indexOf('std_') === 0;

  /* badge */
  var badgeHtml = isStd
    ? '<span style="font-size:10px;background:#1976D2;color:#fff;border-radius:3px;padding:1px 4px;margin-left:4px;">standard</span>'
    : ('<span class="' + (isReq ? 'pcu-chip-req' : 'pcu-chip-opt') + '">' + (isReq ? 'required' : 'optional') + '</span>');

  /* tick the hidden checkbox (id uses the fid directly) */
  var cb = document.getElementById('pcu-cb-' + tid + '-' + fid);
  if (cb) cb.checked = true;

  /* remove option from dropdown */
  sel.remove(sel.selectedIndex);
  sel.value = '';

  /* hide empty placeholder */
  var empty = document.getElementById('pcu-empty-' + tid);
  if (empty) empty.style.display = 'none';

  /* build chip with drag handle */
  var chip = document.createElement('span');
  chip.className   = 'pcu-chip';
  chip.id          = 'pcu-chip-' + tid + '-' + fid;
  chip.draggable   = true;
  chip.dataset.fid = fid;
  chip.dataset.tid = String(tid);
  var tidJ = JSON.stringify(tid), fidJ = JSON.stringify(fid);
  /* children must not be draggable themselves — they'd steal the dragstart */
  chip.innerHTML =
    '<span class="pcu-drag-handle" title="Drag to reorder" draggable="false">&#8942;</span>' +
    ' ' + pcuEsc(fName) + ' ' + badgeHtml +
    ' <button type="button" class="pcu-chip-remove" title="Remove" draggable="false"' +
    '         onclick="pcuRemove(' + tidJ + ',' + fidJ + ')">&#215;</button>';
  document.getElementById('pcu-chips-' + tid).appendChild(chip);

  pcuUpdateCount(tid);
}

/* ── Remove field ───────────────────────────────────────────────────────── */
function pcuRemove(tid, fid) {
  /* untick the hidden checkbox */
  var cb = document.getElementById('pcu-cb-' + tid + '-' + fid);
  if (!cb) return;
  cb.checked = false;

  var fName  = cb.dataset.name;
  var isReq  = cb.dataset.required === '1';
  var isStd  = fid.indexOf('std_') === 0;
  var sel    = document.getElementById('pcu-sel-' + tid);

  if (sel) {
    var newOpt = document.createElement('option');
    newOpt.value            = fid;
    newOpt.dataset.name     = fName;
    newOpt.dataset.required = cb.dataset.required;
    newOpt.dataset.fid      = fid;
    newOpt.textContent      = fName + (isStd ? '' : ' (' + (isReq ? 'required' : 'optional') + ')');

    /* find or create the correct optgroup */
    var groupLabel = isStd ? 'Standard Redmine Fields' : 'Custom Fields';
    var grp = null;
    for (var g = 0; g < sel.children.length; g++) {
      if (sel.children[g].label === groupLabel) { grp = sel.children[g]; break; }
    }
    if (!grp) {
      grp = document.createElement('optgroup');
      grp.label = groupLabel;
      /* standard fields group goes before custom */
      if (isStd) sel.insertBefore(grp, sel.querySelector('optgroup') || null);
      else sel.appendChild(grp);
    }

    /* insert alphabetically within the group */
    var inserted = false;
    for (var i = 0; i < grp.children.length; i++) {
      if (grp.children[i].text.toLowerCase() > newOpt.text.toLowerCase()) {
        grp.insertBefore(newOpt, grp.children[i]); inserted = true; break;
      }
    }
    if (!inserted) grp.appendChild(newOpt);
  }

  /* remove chip */
  var chip = document.getElementById('pcu-chip-' + tid + '-' + fid);
  if (chip) chip.remove();

  /* show empty placeholder if no chips remain */
  var chips = document.querySelectorAll('#pcu-chips-' + tid + ' .pcu-chip');
  if (chips.length === 0) {
    var empty = document.getElementById('pcu-empty-' + tid);
    if (empty) {
      empty.style.display = '';
    } else {
      var span = document.createElement('span');
      span.className   = 'pcu-chips-empty';
      span.id          = 'pcu-empty-' + tid;
      span.textContent = 'No fields added yet — use the dropdown below to add fields.';
      document.getElementById('pcu-chips-' + tid).appendChild(span);
    }
  }

  pcuUpdateCount(tid);
}

/* ── Update badge counter in accordion header ───────────────────────────── */
function pcuUpdateCount(tid) {
  var chips = document.querySelectorAll('#pcu-chips-' + tid + ' .pcu-chip');
  var badge = document.getElementById('pcu-count-' + tid);
  if (!badge) return;
  var n = chips.length;
  badge.textContent = n;
  badge.nextElementSibling.textContent = ' field' + (n === 1 ? '' : 's') + ' in popup';
}

/* ── Select All fields for a tracker ───────────────────────────────────── */
function pcuSelectAll(tid) {
  var sel = document.getElementById('pcu-sel-' + tid);
  if (!sel) return;
  /* iterate optgroups and options, add each available field */
  var toAdd = [];
  for (var g = 0; g < sel.children.length; g++) {
    var child = sel.children[g];
    if (child.tagName === 'OPTGROUP') {
      for (var i = 0; i < child.children.length; i++) {
        toAdd.push(child.children[i].value);
      }
    } else if (child.tagName === 'OPTION' && child.value) {
      toAdd.push(child.value);
    }
  }
  /* set selection then call pcuAdd for each */
  toAdd.forEach(function(fid) {
    sel.value = fid;
    pcuAdd(tid);
  });
}

/* ── Clear All fields for a tracker ────────────────────────────────────── */
function pcuClearAll(tid) {
  var chips = document.querySelectorAll('#pcu-chips-' + tid + ' .pcu-chip');
  var fids = [];
  chips.forEach(function(chip) {
    /* chip id = "pcu-chip-<tid>-<fid>" */
    var id = chip.id || '';
    var prefix = 'pcu-chip-' + tid + '-';
    if (id.indexOf(prefix) === 0) fids.push(id.slice(prefix.length));
  });
  fids.forEach(function(fid) { pcuRemove(tid, fid); });
}

/* ── Sync hidden checkbox DOM order to match current chip order ─────────── */
/* Called after any reorder so the form submits fields in the right sequence */
function pcuSyncCheckboxOrder(tid) {
  var chipsBox    = document.getElementById('pcu-chips-' + tid);
  var cbContainer = document.getElementById('pcu-cb-container-' + tid);
  if (!chipsBox || !cbContainer) return;
  var prefix = 'pcu-chip-' + tid + '-';
  Array.from(chipsBox.querySelectorAll('.pcu-chip')).forEach(function(c) {
    var chipFid = c.id.slice(prefix.length);
    var cb = document.getElementById('pcu-cb-' + tid + '-' + chipFid);
    if (cb && cb.checked) cbContainer.appendChild(cb);
  });
  Array.from(cbContainer.querySelectorAll('input[type=checkbox]')).forEach(function(cb) {
    if (!cb.checked) cbContainer.appendChild(cb);
  });
}

/* ── Drag-and-drop reordering ───────────────────────────────────────────── */
var _pcuDrag = { box: null, chip: null };

function pcuSetupDrag(tid) {
  var box = document.getElementById('pcu-chips-' + tid);
  if (!box || box._pcuDragReady) return;
  box._pcuDragReady = true;

  /* Walk up the DOM from el until we hit a direct .pcu-chip child of box */
  function chipOf(el) {
    while (el && el !== box) {
      if (el.parentNode === box && el.classList && el.classList.contains('pcu-chip')) return el;
      el = el.parentNode;
    }
    return null;
  }

  function clearOver() {
    var chips = box.querySelectorAll('.pcu-chip.pcu-drag-over');
    for (var i = 0; i < chips.length; i++) chips[i].classList.remove('pcu-drag-over');
  }

  box.addEventListener('dragstart', function(e) {
    /* e.target is the element that has draggable=true, i.e. the chip span itself */
    var chip = chipOf(e.target) || (e.target.classList && e.target.classList.contains('pcu-chip') ? e.target : null);
    if (!chip) { e.preventDefault(); return; }
    _pcuDrag.box  = box;
    _pcuDrag.chip = chip;
    e.dataTransfer.effectAllowed = 'move';
    e.dataTransfer.setData('text/plain', chip.id);
    /* Delay so the drag image renders before we fade the chip */
    setTimeout(function() { chip.classList.add('pcu-dragging'); }, 0);
  });

  box.addEventListener('dragover', function(e) {
    if (_pcuDrag.box !== box) return;
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
    var target = chipOf(e.target);
    clearOver();
    if (target && target !== _pcuDrag.chip) target.classList.add('pcu-drag-over');
  });

  box.addEventListener('dragleave', function(e) {
    if (!box.contains(e.relatedTarget)) clearOver();
  });

  box.addEventListener('drop', function(e) {
    e.preventDefault();
    clearOver();
    if (_pcuDrag.box !== box || !_pcuDrag.chip) return;
    var target = chipOf(e.target);
    if (!target || target === _pcuDrag.chip) return;
    var rect  = target.getBoundingClientRect();
    var after = (e.clientY - rect.top) > rect.height / 2;
    box.insertBefore(_pcuDrag.chip, after ? target.nextSibling : target);
    pcuSyncCheckboxOrder(tid);
  });

  box.addEventListener('dragend', function() {
    if (_pcuDrag.chip) _pcuDrag.chip.classList.remove('pcu-dragging');
    clearOver();
    _pcuDrag = { box: null, chip: null };
  });
}

/* Initialise drag on every chip container once the page has fully rendered */
document.addEventListener('DOMContentLoaded', function() {
  var containers = document.querySelectorAll('[id^="pcu-chips-"]');
  for (var i = 0; i < containers.length; i++) {
    var tid = parseInt(containers[i].id.replace('pcu-chips-', ''), 10);
    if (!isNaN(tid)) pcuSetupDrag(tid);
  }
});

/* ── HTML-escape helper ─────────────────────────────────────────────────── */
function pcuEsc(str) {
  return String(str)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;')
    .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
</script>
