<%- @settings ||= {} %>

<style>
.tfc-box          { border:1px solid #ddd; border-radius:4px; margin-bottom:20px; }
.tfc-box-head     { padding:9px 14px; background:#f5f5f5; border-bottom:1px solid #ddd;
                    font-weight:bold; font-size:13px; color:#333; }
.tfc-box-body     { padding:14px 16px; }
.tfc-setting      { margin-bottom:14px; }
.tfc-setting:last-child { margin-bottom:0; }
.tfc-setting label      { font-weight:bold; display:block; margin-bottom:4px; font-size:13px; }
.tfc-setting label.inline { display:inline; font-weight:normal; }
.tfc-hint         { color:#777; font-size:12px; margin-top:3px; }

.tfc-project-select { padding:6px 8px; font-size:13px; min-width:280px; margin-bottom:16px; }

.tfc-project-panel  { display:none; }
.tfc-project-panel.tfc-active { display:block; }
.tfc-no-projects    { color:#aaa; font-size:13px; font-style:italic; }
.tfc-no-trackers    { color:#aaa; font-size:13px; font-style:italic; }

.tfc-tracker      { border:1px solid #ddd; border-radius:4px; margin-bottom:10px; }
.tfc-tracker-hd   { padding:9px 14px; background:#fafafa; cursor:pointer;
                    display:flex; justify-content:space-between; align-items:center;
                    font-size:13px; font-weight:bold; user-select:none; }
.tfc-tracker-hd:hover { background:#eef5fb; }
.tfc-tracker-bd   { padding:14px 16px; display:none; border-top:1px solid #eee; }
.tfc-tracker-bd.tfc-open { display:block; }
.tfc-arrow        { font-size:11px; color:#888; }
.tfc-count-badge  { font-size:11px; background:#4c96c4; color:#fff; border-radius:10px;
                    padding:1px 7px; margin-left:6px; font-weight:normal; }

.tfc-field-table  { width:100%; border-collapse:collapse; font-size:13px; }
.tfc-field-table th { text-align:left; padding:7px 10px; border:1px solid #ddd; background:#f5f5f5; color:#444; }
.tfc-field-table td { padding:6px 10px; border:1px solid #eee; vertical-align:middle; }
.tfc-field-table select { width:100%; max-width:260px; padding:5px 7px; font-size:13px;
                          border:1px solid #ccc; border-radius:3px; }
.tfc-loading      { color:#888; font-size:13px; font-style:italic; padding:10px 0; }
.tfc-load-error   { color:#c62828; font-size:13px; padding:10px 0; }
</style>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 1 - General
    ═══════════════════════════════════════════════════════════════════════════ %>
<div class="tfc-box">
  <div class="tfc-box-head">General</div>
  <div class="tfc-box-body">
    <div class="tfc-setting">
      <label class="inline">
        <%= check_box_tag 'settings[enabled]', '1', @settings['enabled'] != '0' %>
        Enable Tracker Fields Configuration plugin
      </label>
      <p class="tfc-hint">
        When disabled, all custom fields render in their normal position and no fields are moved.
      </p>
    </div>
  </div>
</div>

<style>
.tfc-mode-toggle    { display:flex; gap:8px; margin-bottom:14px; }
.tfc-mode-btn       { padding:6px 14px; font-size:12px; border:1px solid #ccc; border-radius:4px;
                      background:#fff; cursor:pointer; }
.tfc-mode-btn.tfc-mode-btn-active { background:#1976D2; color:#fff; border-color:#1976D2; }
.tfc-mode-panel     { display:none; }
.tfc-mode-panel.tfc-mode-active { display:block; }

.tfc-tree           { max-height:320px; overflow-y:auto; border:1px solid #ddd; border-radius:4px;
                      padding:8px 10px; background:#fff; margin-bottom:12px; }
.tfc-tree-row       { padding:3px 0; font-size:13px; white-space:nowrap; }
.tfc-tree-row label { font-weight:normal; cursor:pointer; }
.tfc-tree-row input[type=checkbox] { margin-right:6px; vertical-align:middle; }
</style>

<%# ═══════════════════════════════════════════════════════════════════════════
    Project tree data shared by both Section 2 and Section 3's "configure
    multiple projects" mode below. Computed once, here, from the nested
    set's own lft/rgt boundaries (Project.active.sorted already returns
    rows in depth-first order) so no N+1 ancestor/descendant queries are
    needed per project.
    ═══════════════════════════════════════════════════════════════════════════ %>
<%
  tfc_all_projects = Project.active.sorted.to_a
  tfc_active_ids = tfc_all_projects.map(&:id)

  tfc_level_stack = []
  tfc_project_tree = tfc_all_projects.map do |p|
    tfc_level_stack.pop while tfc_level_stack.any? && tfc_level_stack.last < p.lft
    level = tfc_level_stack.size
    tfc_level_stack.push(p.rgt)
    parent_id = (p.parent_id && tfc_active_ids.include?(p.parent_id)) ? p.parent_id : nil
    { id: p.id, name: p.name, level: level, parent_id: parent_id }
  end

  tfc_children_by_parent = Hash.new { |h, k| h[k] = [] }
  tfc_project_tree.each { |node| tfc_children_by_parent[node[:parent_id]] << node[:id] if node[:parent_id] }

  tfc_descendants_by_id = {}
  tfc_project_tree.each do |node|
    acc = []
    stack = tfc_children_by_parent[node[:id]].dup
    until stack.empty?
      cid = stack.shift
      acc << cid
      stack.concat(tfc_children_by_parent[cid])
    end
    tfc_descendants_by_id[node[:id]] = acc
  end
%>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 2 - Per-project field promotion
    Two modes, toggled by the buttons below, sharing the same settings keys:
    - "Configure one project" (default): the original flow, completely
      unchanged - project list loaded up front (cheap - id/name only),
      each project's tracker/custom-field table fetched on demand and
      cached in the DOM. Untouched because it's already working.
    - "Configure multiple projects": NEW - a checkbox tree (checking a
      parent auto-checks all its sub-projects) drives a bulk panel showing
      the union of trackers across every checked project; saving
      overwrites those projects' configuration for the trackers shown.
    ═══════════════════════════════════════════════════════════════════════════ %>
<%
  tfc_projects = Project.active.sorted.pluck(:id, :name)
%>
<div class="tfc-box">
  <div class="tfc-box-head">Move Custom Fields to Standard Fields Area</div>
  <div class="tfc-box-body">
    <p style="margin:0 0 14px;color:#555;font-size:13px;">
      For each tracker, choose which custom fields should be promoted into the standard fields
      area of the issue form, and which standard field each one should appear directly after. The
      lists of projects, trackers and custom fields are always read live from this Redmine
      instance.
    </p>

    <div id="tfc-promote-modes">
      <div class="tfc-mode-toggle">
        <button type="button" class="tfc-mode-btn tfc-mode-btn-active" data-mode="single"
                onclick="tfcSwitchMode('tfc-promote-modes', 'single')">Configure one project</button>
        <button type="button" class="tfc-mode-btn" data-mode="bulk"
                onclick="tfcSwitchMode('tfc-promote-modes', 'bulk')">Configure multiple projects</button>
      </div>

      <div class="tfc-mode-panel tfc-mode-active" data-mode="single">
    <% if tfc_projects.empty? %>
      <p class="tfc-no-projects">No active projects found in this Redmine instance.</p>
    <% else %>
      <label for="tfc-project-select" style="display:block;font-weight:bold;font-size:13px;margin-bottom:4px;">
        Project
      </label>
      <select id="tfc-project-select" class="tfc-project-select" onchange="tfcShowProject(this.value)">
        <% tfc_projects.each do |pid, pname| %>
          <option value="<%= pid %>"><%= pname %></option>
        <% end %>
      </select>

      <div id="tfc-projects-container"></div>

      <%# ═════════════════════════════════════════════════════════════════════
          Preserve the currently-saved selections for every project as hidden
          fields. The settings form always resubmits the *entire* nested
          config in one go, so without this, saving while a project's panel
          was never opened in this browser session would silently wipe that
          project's configuration. Once a project is loaded into a live,
          editable panel, its hidden fields here are removed by JS so the
          live inputs are the only ones submitted for it.
          ═════════════════════════════════════════════════════════════════════ %>
      <%
        raw_fields_cfg = TrackerFieldsConfiguration.hash_at('project_tracker_fields')
        raw_after_cfg  = TrackerFieldsConfiguration.hash_at('project_tracker_after')
      %>
      <div id="tfc-preserved-fields" style="display:none;">
        <% raw_fields_cfg.each do |ppid, trackers| %>
          <% next unless trackers.is_a?(Hash) %>
          <% trackers.each do |ttid, cf_ids| %>
            <% Array(cf_ids).each do |cf_id| %>
              <input type="hidden" class="tfc-preserve tfc-preserve-<%= ppid %>"
                     name="settings[project_tracker_fields][<%= ppid %>][<%= ttid %>][]"
                     value="<%= cf_id %>">
            <% end %>
          <% end %>
        <% end %>
        <% raw_after_cfg.each do |ppid, trackers| %>
          <% next unless trackers.is_a?(Hash) %>
          <% trackers.each do |ttid, cf_map| %>
            <% next unless cf_map.is_a?(Hash) %>
            <% cf_map.each do |cf_id, after_key| %>
              <input type="hidden" class="tfc-preserve tfc-preserve-<%= ppid %>"
                     name="settings[project_tracker_after][<%= ppid %>][<%= ttid %>][<%= cf_id %>]"
                     value="<%= after_key %>">
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
      </div>

      <%# ═══════════════════════════════════════════════════════════════════
          "Configure multiple projects" mode - checkbox tree + bulk panel.
          The bulk panel and its shadow-form container are populated
          entirely by JS (tfcPromoteLoadBulkPanel / tfcBulkSync below); no
          settings[...] names are rendered server-side here.
          ═══════════════════════════════════════════════════════════════════ %>
      <div class="tfc-mode-panel" data-mode="bulk">
        <p class="tfc-hint" style="margin-bottom:8px;">
          Check a project to select it, or check a parent project to also select all of its
          sub-projects. Configure the fields below once, then save to apply that configuration to
          every checked project.
        </p>
        <div class="tfc-tree" id="tfc-ptree-container">
          <% tfc_project_tree.each do |node| %>
            <div class="tfc-tree-row" style="padding-left:<%= node[:level] * 18 %>px;">
              <label>
                <input type="checkbox" class="tfc-tree-cb" id="tfc-ptree-cb-<%= node[:id] %>"
                       data-project-id="<%= node[:id] %>"
                       data-parent-id="<%= node[:parent_id] %>"
                       data-descendants="<%= tfc_descendants_by_id[node[:id]].join(',') %>"
                       onchange="tfcTreeToggle('tfc-ptree', this, tfcPromoteSelectionChanged)">
                <%= node[:name] %>
              </label>
            </div>
          <% end %>
        </div>

        <div id="tfc-bulk-panel">
          <p class="tfc-hint">Check one or more projects above to configure their fields.</p>
        </div>
        <div id="tfc-bulk-shadow" style="display:none;"></div>
      </div>
    </div>
  </div>
</div>

<%# ═══════════════════════════════════════════════════════════════════════════
    SECTION 3 - Hide / unhide fields. A separate feature from field
    promotion above: its own settings key (project_tracker_hidden_fields),
    own project picker, own container, own preserved-fields block and own
    JS namespace (tfcHide*), so it cannot interact with or break Section 2.
    ═══════════════════════════════════════════════════════════════════════════ %>
<style>
.tfc-hide-project-panel { display:none; }
.tfc-hide-project-panel.tfc-hide-active { display:block; }
</style>
<%
  tfc_hide_projects = Project.active.sorted.pluck(:id, :name)
%>
<div class="tfc-box">
  <div class="tfc-box-head">Hide / Unhide Fields</div>
  <div class="tfc-box-body">
    <p style="margin:0 0 14px;color:#555;font-size:13px;">
      For each tracker, choose which fields (standard or custom) should be completely hidden from
      both the issue form and the issue view page. This is independent of the field-promotion
      settings above - hiding a field here works whether or not it's also configured to be
      promoted.
    </p>

    <div id="tfc-hide-modes">
      <div class="tfc-mode-toggle">
        <button type="button" class="tfc-mode-btn tfc-mode-btn-active" data-mode="single"
                onclick="tfcSwitchMode('tfc-hide-modes', 'single')">Configure one project</button>
        <button type="button" class="tfc-mode-btn" data-mode="bulk"
                onclick="tfcSwitchMode('tfc-hide-modes', 'bulk')">Configure multiple projects</button>
      </div>

      <div class="tfc-mode-panel tfc-mode-active" data-mode="single">
        <p class="tfc-hint" style="margin-bottom:8px;">
          Also the only place to register fields from other plugins (e.g. Agile "Sprint") - see
          "Other fields" under each tracker below.
        </p>
    <% if tfc_hide_projects.empty? %>
      <p class="tfc-no-projects">No active projects found in this Redmine instance.</p>
    <% else %>
      <label for="tfc-hide-project-select" style="display:block;font-weight:bold;font-size:13px;margin-bottom:4px;">
        Project
      </label>
      <select id="tfc-hide-project-select" class="tfc-project-select" onchange="tfcHideShowProject(this.value)">
        <% tfc_hide_projects.each do |pid, pname| %>
          <option value="<%= pid %>"><%= pname %></option>
        <% end %>
      </select>

      <div id="tfc-hide-projects-container"></div>

      <%# Same "preserve unedited projects" safeguard as Section 2 above,
          scoped to this feature's own settings keys and its own class
          names so it can never remove Section 2's preserved fields or vice
          versa. Covers all three keys this section owns: which fields are
          hidden, plus the registered extra-field catalog and its labels -
          without preserving the latter two, saving while another
          project's Sprint-style registrations were never loaded this
          session would wipe them. %>
      <%
        raw_hidden_cfg = TrackerFieldsConfiguration.hash_at('project_tracker_hidden_fields')
        raw_extra_cfg = TrackerFieldsConfiguration.hash_at('project_tracker_extra_fields')
        raw_extra_labels_cfg = TrackerFieldsConfiguration.hash_at('project_tracker_extra_field_labels')
      %>
      <div id="tfc-hide-preserved-fields" style="display:none;">
        <% raw_hidden_cfg.each do |ppid, trackers| %>
          <% next unless trackers.is_a?(Hash) %>
          <% trackers.each do |ttid, field_keys| %>
            <% Array(field_keys).each do |field_key| %>
              <input type="hidden" class="tfc-hide-preserve tfc-hide-preserve-<%= ppid %>"
                     name="settings[project_tracker_hidden_fields][<%= ppid %>][<%= ttid %>][]"
                     value="<%= field_key %>">
            <% end %>
          <% end %>
        <% end %>
        <% raw_extra_cfg.each do |ppid, trackers| %>
          <% next unless trackers.is_a?(Hash) %>
          <% trackers.each do |ttid, keys| %>
            <% Array(keys).each do |extra_key| %>
              <input type="hidden" class="tfc-hide-preserve tfc-hide-preserve-<%= ppid %>"
                     name="settings[project_tracker_extra_fields][<%= ppid %>][<%= ttid %>][]"
                     value="<%= extra_key %>">
            <% end %>
          <% end %>
        <% end %>
        <% raw_extra_labels_cfg.each do |ppid, trackers| %>
          <% next unless trackers.is_a?(Hash) %>
          <% trackers.each do |ttid, label_map| %>
            <% next unless label_map.is_a?(Hash) %>
            <% label_map.each do |extra_key, label| %>
              <input type="hidden" class="tfc-hide-preserve tfc-hide-preserve-<%= ppid %>"
                     name="settings[project_tracker_extra_field_labels][<%= ppid %>][<%= ttid %>][<%= extra_key %>]"
                     value="<%= label %>">
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
      </div>

      <%# ═══════════════════════════════════════════════════════════════════
          "Configure multiple projects" mode. No "Other fields" support here
          deliberately - registering a plugin field is inherently a
          per-project+tracker action, so it stays on the single-project
          panel above. Any already-registered extra fields' hidden state is
          preserved untouched by the bulk save (see _bulk_hidden_fields).
          ═══════════════════════════════════════════════════════════════════ %>
      <div class="tfc-mode-panel" data-mode="bulk">
        <p class="tfc-hint" style="margin-bottom:8px;">
          Check a project to select it, or check a parent project to also select all of its
          sub-projects. Configure the fields below once, then save to apply that configuration to
          every checked project.
        </p>
        <div class="tfc-tree" id="tfc-htree-container">
          <% tfc_project_tree.each do |node| %>
            <div class="tfc-tree-row" style="padding-left:<%= node[:level] * 18 %>px;">
              <label>
                <input type="checkbox" class="tfc-tree-cb" id="tfc-htree-cb-<%= node[:id] %>"
                       data-project-id="<%= node[:id] %>"
                       data-parent-id="<%= node[:parent_id] %>"
                       data-descendants="<%= tfc_descendants_by_id[node[:id]].join(',') %>"
                       onchange="tfcTreeToggle('tfc-htree', this, tfcHideBulkSelectionChanged)">
                <%= node[:name] %>
              </label>
            </div>
          <% end %>
        </div>

        <div id="tfc-bulkhide-panel">
          <p class="tfc-hint">Check one or more projects above to configure their fields.</p>
        </div>
        <div id="tfc-bulkhide-shadow" style="display:none;"></div>
        <%# Holds real settings[...] inputs for "Other fields" registered via
            tfcBulkHideAddExtra below. Lives outside #tfc-bulkhide-panel so a
            later tree-selection change (which refetches and replaces that
            panel's whole innerHTML) never wipes an addition made earlier in
            this session. %>
        <div id="tfc-bulkhide-extra-additions" style="display:none;"></div>
      </div>
    </div>
  </div>
</div>

<script>
var TFC_FIELDS_URL = "<%= j tracker_fields_configuration_project_fields_path %>";
var TFC_HIDDEN_FIELDS_URL = "<%= j tracker_fields_configuration_project_hidden_fields_path %>";
var TFC_BULK_FIELDS_URL = "<%= j tracker_fields_configuration_bulk_fields_path %>";
var TFC_BULK_HIDDEN_FIELDS_URL = "<%= j tracker_fields_configuration_bulk_hidden_fields_path %>";
</script>

<script>
function tfcShowProject(pid) {
  document.querySelectorAll('.tfc-project-panel').forEach(function(panel) {
    panel.classList.remove('tfc-active');
  });

  var existing = document.getElementById('tfc-project-' + pid);
  if (existing) {
    existing.classList.add('tfc-active');
    return;
  }

  var container = document.getElementById('tfc-projects-container');
  if (!container) return;

  var panel = document.createElement('div');
  panel.className = 'tfc-project-panel tfc-active';
  panel.id = 'tfc-project-' + pid;
  panel.innerHTML = '<p class="tfc-loading">Loading fields&hellip;</p>';
  container.appendChild(panel);

  fetch(TFC_FIELDS_URL + '?id=' + encodeURIComponent(pid), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    credentials: 'same-origin'
  }).then(function(response) {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
  }).then(function(html) {
    panel.innerHTML = html;
    // This project now has live, editable inputs in the form - drop the
    // hidden "preserve as-is" fields for it so we don't submit both.
    document.querySelectorAll('.tfc-preserve-' + pid).forEach(function(el) { el.remove(); });
  }).catch(function(err) {
    panel.innerHTML = '<p class="tfc-load-error">Could not load fields for this project: ' + err.message + '</p>';
  });
}

document.addEventListener('DOMContentLoaded', function() {
  var select = document.getElementById('tfc-project-select');
  if (select && select.value) tfcShowProject(select.value);
});

function tfcToggleTracker(key) {
  var body  = document.getElementById('tfc-body-'  + key);
  var arrow = document.getElementById('tfc-arrow-' + key);
  if (!body) return;
  if (body.classList.contains('tfc-open')) {
    body.classList.remove('tfc-open');
    arrow.innerHTML = '&#9660;';
  } else {
    body.classList.add('tfc-open');
    arrow.innerHTML = '&#9650;';
  }
}

function tfcUpdateCount(key) {
  var body = document.getElementById('tfc-body-' + key);
  var badge = document.getElementById('tfc-count-' + key);
  if (!body || !badge) return;
  var checked = body.querySelectorAll('input[type=checkbox]:checked').length;
  badge.textContent = checked;
  badge.nextElementSibling.textContent = ' / ' + body.querySelectorAll('input[type=checkbox]').length +
    ' field' + (body.querySelectorAll('input[type=checkbox]').length === 1 ? '' : 's') + ' promoted';
}
</script>

<%# ═══════════════════════════════════════════════════════════════════════════
    Section 3's own JS namespace (tfcHide*) - entirely separate functions and
    element ids from Section 2's above, so neither can interfere with the
    other's project panels, accordions or counters.
    ═══════════════════════════════════════════════════════════════════════════ %>
<script>
function tfcHideShowProject(pid) {
  document.querySelectorAll('.tfc-hide-project-panel').forEach(function(panel) {
    panel.classList.remove('tfc-hide-active');
  });

  var existing = document.getElementById('tfc-hide-project-' + pid);
  if (existing) {
    existing.classList.add('tfc-hide-active');
    return;
  }

  var container = document.getElementById('tfc-hide-projects-container');
  if (!container) return;

  var panel = document.createElement('div');
  panel.className = 'tfc-hide-project-panel tfc-hide-active';
  panel.id = 'tfc-hide-project-' + pid;
  panel.innerHTML = '<p class="tfc-loading">Loading fields&hellip;</p>';
  container.appendChild(panel);

  fetch(TFC_HIDDEN_FIELDS_URL + '?id=' + encodeURIComponent(pid), {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    credentials: 'same-origin'
  }).then(function(response) {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
  }).then(function(html) {
    panel.innerHTML = html;
    document.querySelectorAll('.tfc-hide-preserve-' + pid).forEach(function(el) { el.remove(); });
  }).catch(function(err) {
    panel.innerHTML = '<p class="tfc-load-error">Could not load fields for this project: ' + err.message + '</p>';
  });
}

document.addEventListener('DOMContentLoaded', function() {
  var select = document.getElementById('tfc-hide-project-select');
  if (select && select.value) tfcHideShowProject(select.value);
});

function tfcHideToggleTracker(key) {
  var body  = document.getElementById('tfc-hide-body-'  + key);
  var arrow = document.getElementById('tfc-hide-arrow-' + key);
  if (!body) return;
  if (body.classList.contains('tfc-open')) {
    body.classList.remove('tfc-open');
    arrow.innerHTML = '&#9660;';
  } else {
    body.classList.add('tfc-open');
    arrow.innerHTML = '&#9650;';
  }
}

function tfcHideUpdateCount(key) {
  var body = document.getElementById('tfc-hide-body-' + key);
  var badge = document.getElementById('tfc-hide-count-' + key);
  if (!body || !badge) return;
  var checked = body.querySelectorAll('input[type=checkbox]:checked').length;
  badge.textContent = checked;
  badge.nextElementSibling.textContent = ' / ' + body.querySelectorAll('input[type=checkbox]').length +
    ' field' + (body.querySelectorAll('input[type=checkbox]').length === 1 ? '' : 's') + ' hidden';
}

/* ── "Other fields" (non-CustomField plugin fields, e.g. Agile Sprint) ──
   These functions live here (the fully-loaded page), not inside the
   Ajax-fetched hide/unhide partial, because <script> tags inside HTML
   assigned via element.innerHTML never execute - only the onclick
   attributes in that fetched HTML reference these global functions. */
function tfcHideEsc(str) {
  return String(str)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;')
    .replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

function tfcHideAddExtra(pid, tid, key) {
  var labelInput = document.getElementById('tfc-extra-label-' + key);
  var keyInput = document.getElementById('tfc-extra-key-' + key);
  var label = labelInput.value.trim();
  var fieldKeyRaw = keyInput.value.trim().replace(/^issue_/, '');

  if (!label || !fieldKeyRaw) {
    alert('Please enter both a label and an id.');
    return;
  }
  if (document.getElementById('tfc-extra-row-' + key + '-' + fieldKeyRaw)) {
    alert('That field is already added.');
    return;
  }

  var fieldKey = 'ext_' + fieldKeyRaw;
  var cbId = 'tfc-hide-cb-' + key + '-' + fieldKey;

  var emptyMsg = document.getElementById('tfc-extra-empty-' + key);
  if (emptyMsg) emptyMsg.remove();

  var tbody = document.getElementById('tfc-extra-table-' + key).querySelector('tbody');
  var tr = document.createElement('tr');
  tr.id = 'tfc-extra-row-' + key + '-' + fieldKeyRaw;
  tr.innerHTML =
    '<td><input type="checkbox" name="settings[project_tracker_hidden_fields][' + pid + '][' + tid + '][]" ' +
    'value="' + tfcHideEsc(fieldKey) + '" id="' + tfcHideEsc(cbId) + '" checked ' +
    'onchange="tfcHideUpdateCount(' + JSON.stringify(key) + ')"></td>' +
    '<td><label for="' + tfcHideEsc(cbId) + '">' + tfcHideEsc(label) + '</label>' +
    '<input type="hidden" name="settings[project_tracker_extra_fields][' + pid + '][' + tid + '][]" value="' + tfcHideEsc(fieldKeyRaw) + '">' +
    '<input type="hidden" name="settings[project_tracker_extra_field_labels][' + pid + '][' + tid + '][' + tfcHideEsc(fieldKeyRaw) + ']" value="' + tfcHideEsc(label) + '"></td>' +
    '<td><button type="button" class="tfc-add-btn" style="background:#e53935;padding:3px 8px;font-size:11px;" ' +
    'onclick="tfcHideRemoveExtra(' + JSON.stringify(key) + ', ' + JSON.stringify(fieldKeyRaw) + ')">Remove</button></td>';
  tbody.appendChild(tr);

  labelInput.value = '';
  keyInput.value = '';
  tfcHideUpdateCount(key);
}

function tfcHideRemoveExtra(key, fieldKeyRaw) {
  var row = document.getElementById('tfc-extra-row-' + key + '-' + fieldKeyRaw);
  if (row) row.remove();
  tfcHideUpdateCount(key);
}
</script>

<%# ═══════════════════════════════════════════════════════════════════════════
    "Configure multiple projects" mode - shared tree logic plus the two
    bulk panels (promote / hide). Entirely new script block, appended
    after everything above rather than edited into it, so the
    already-working single-project flows in both sections are untouched
    byte-for-byte.
    ═══════════════════════════════════════════════════════════════════════════ %>
<script>
/* ── Generic checkbox-tree cascade, shared by both sections ────────────── */
/* prefix is either 'tfc-ptree' (promote) or 'tfc-htree' (hide); each tree's
   checkboxes have id="<prefix>-cb-<projectId>" and carry data-project-id /
   data-parent-id / data-descendants attributes rendered server-side. */

function tfcTreeContainer(prefix) {
  return document.getElementById(prefix + '-container');
}

function tfcTreeCheckedIds(prefix) {
  var container = tfcTreeContainer(prefix);
  var ids = [];
  if (!container) return ids;
  container.querySelectorAll('.tfc-tree-cb').forEach(function(cb) {
    if (cb.checked) ids.push(cb.dataset.projectId);
  });
  return ids;
}

function tfcTreeCascadeDown(prefix, cb) {
  var ids = (cb.dataset.descendants || '').split(',').filter(Boolean);
  ids.forEach(function(id) {
    var child = document.getElementById(prefix + '-cb-' + id);
    if (child) { child.checked = cb.checked; child.indeterminate = false; }
  });
}

function tfcTreeRefreshAncestors(prefix, cb) {
  var parentId = cb.dataset.parentId;
  while (parentId) {
    var parentCb = document.getElementById(prefix + '-cb-' + parentId);
    if (!parentCb) break;

    var descIds = (parentCb.dataset.descendants || '').split(',').filter(Boolean);
    var states = descIds.map(function(id) {
      var el = document.getElementById(prefix + '-cb-' + id);
      return el ? el.checked : false;
    });
    var anyChecked = states.some(function(s) { return s; });
    var allChecked = states.length > 0 && states.every(function(s) { return s; });

    parentCb.checked = allChecked;
    parentCb.indeterminate = anyChecked && !allChecked;
    parentId = parentCb.dataset.parentId;
  }
}

/* Called by each tree checkbox's onchange. onSelectionChanged is the
   section-specific function that reloads that section's bulk panel. */
function tfcTreeToggle(prefix, cb, onSelectionChanged) {
  cb.indeterminate = false;
  tfcTreeCascadeDown(prefix, cb);
  tfcTreeRefreshAncestors(prefix, cb);
  onSelectionChanged();
}

/* ── Mode toggle (Configure one project / Configure multiple projects) ── */
function tfcSwitchMode(containerId, mode) {
  var container = document.getElementById(containerId);
  if (!container) return;
  container.querySelectorAll('.tfc-mode-panel').forEach(function(panel) {
    panel.classList.toggle('tfc-mode-active', panel.dataset.mode === mode);
  });
  container.querySelectorAll('.tfc-mode-btn').forEach(function(btn) {
    btn.classList.toggle('tfc-mode-btn-active', btn.dataset.mode === mode);
  });
}

/* ── Bulk field promotion ─────────────────────────────────────────────── */
var tfcBulkFetchTimer = null;

function tfcPromoteSelectionChanged() {
  clearTimeout(tfcBulkFetchTimer);
  tfcBulkFetchTimer = setTimeout(tfcPromoteLoadBulkPanel, 250);
}

function tfcPromoteLoadBulkPanel() {
  var ids = tfcTreeCheckedIds('tfc-ptree');
  var panel = document.getElementById('tfc-bulk-panel');
  if (!panel) return;

  // A checked project's existing config is about to be fully replaced by
  // whatever this panel ends up showing - stop submitting its preserved
  // (as-is) fields. Unchecking a project re-enables its preserved fields
  // so its prior configuration is kept exactly as it was.
  document.querySelectorAll('.tfc-preserve').forEach(function(el) { el.disabled = false; });
  ids.forEach(function(pid) {
    document.querySelectorAll('.tfc-preserve-' + pid).forEach(function(el) { el.disabled = true; });
  });

  if (ids.length === 0) {
    panel.innerHTML = '<p class="tfc-hint">Check one or more projects above to configure their fields.</p>';
    tfcBulkSync();
    return;
  }

  panel.innerHTML = '<p class="tfc-loading">Loading fields&hellip;</p>';
  var qs = ids.map(function(id) { return 'project_ids[]=' + encodeURIComponent(id); }).join('&');

  fetch(TFC_BULK_FIELDS_URL + '?' + qs, {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    credentials: 'same-origin'
  }).then(function(response) {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
  }).then(function(html) {
    panel.innerHTML = html;
    tfcBulkSync();
  }).catch(function(err) {
    panel.innerHTML = '<p class="tfc-load-error">Could not load fields: ' + err.message + '</p>';
  });
}

/* Mirrors the bulk panel's visible checkbox/select state into real
   settings[project_tracker_fields][pid][tid][] / settings[project_tracker_after]
   hidden inputs, once per project that actually has that tracker
   (data-applicable-projects, rendered server-side). Re-run on every
   checkbox/select change inside the panel and every time it's reloaded. */
function tfcBulkSync() {
  var shadow = document.getElementById('tfc-bulk-shadow');
  var panel = document.getElementById('tfc-bulk-panel');
  if (!shadow) return;
  if (!panel) { shadow.innerHTML = ''; return; }

  var html = '';
  panel.querySelectorAll('.tfc-tracker[data-tracker-id]').forEach(function(trackerEl) {
    var tid = trackerEl.dataset.trackerId;
    var applicable = (trackerEl.dataset.applicableProjects || '').split(',').filter(Boolean);
    if (!applicable.length) return;

    trackerEl.querySelectorAll('.tfc-bulk-cf-checkbox:checked').forEach(function(cb) {
      var cfId = cb.dataset.cfId;
      var afterSelect = trackerEl.querySelector('.tfc-bulk-cf-after[data-cf-id="' + cfId + '"]');
      var afterVal = afterSelect ? afterSelect.value : '';
      if (!afterVal) return; // same rule as the single-project panel

      applicable.forEach(function(pid) {
        html += '<input type="hidden" name="settings[project_tracker_fields][' + pid + '][' + tid + '][]" value="' + tfcHideEsc(cfId) + '">';
        html += '<input type="hidden" name="settings[project_tracker_after][' + pid + '][' + tid + '][' + tfcHideEsc(cfId) + ']" value="' + tfcHideEsc(afterVal) + '">';
      });
    });
  });

  shadow.innerHTML = html;
}

function tfcBulkToggleTracker(tid) {
  var body  = document.getElementById('tfc-bulk-body-'  + tid);
  var arrow = document.getElementById('tfc-bulk-arrow-' + tid);
  if (!body) return;
  if (body.classList.contains('tfc-open')) {
    body.classList.remove('tfc-open');
    arrow.innerHTML = '&#9660;';
  } else {
    body.classList.add('tfc-open');
    arrow.innerHTML = '&#9650;';
  }
}

/* ── Bulk hide/unhide ─────────────────────────────────────────────────── */
var tfcBulkHideFetchTimer = null;

function tfcHideBulkSelectionChanged() {
  clearTimeout(tfcBulkHideFetchTimer);
  tfcBulkHideFetchTimer = setTimeout(tfcHideBulkLoadPanel, 250);
}

function tfcHideBulkLoadPanel() {
  var ids = tfcTreeCheckedIds('tfc-htree');
  var panel = document.getElementById('tfc-bulkhide-panel');
  if (!panel) return;

  document.querySelectorAll('.tfc-hide-preserve').forEach(function(el) { el.disabled = false; });
  ids.forEach(function(pid) {
    document.querySelectorAll('.tfc-hide-preserve-' + pid).forEach(function(el) { el.disabled = true; });
  });

  if (ids.length === 0) {
    panel.innerHTML = '<p class="tfc-hint">Check one or more projects above to configure their fields.</p>';
    tfcBulkHideSync();
    return;
  }

  panel.innerHTML = '<p class="tfc-loading">Loading fields&hellip;</p>';
  var qs = ids.map(function(id) { return 'project_ids[]=' + encodeURIComponent(id); }).join('&');

  fetch(TFC_BULK_HIDDEN_FIELDS_URL + '?' + qs, {
    headers: { 'X-Requested-With': 'XMLHttpRequest' },
    credentials: 'same-origin'
  }).then(function(response) {
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.text();
  }).then(function(html) {
    panel.innerHTML = html;
    tfcBulkHideSync();
  }).catch(function(err) {
    panel.innerHTML = '<p class="tfc-load-error">Could not load fields: ' + err.message + '</p>';
  });
}

function tfcBulkHideSync() {
  var shadow = document.getElementById('tfc-bulkhide-shadow');
  var panel = document.getElementById('tfc-bulkhide-panel');
  if (!shadow) return;
  if (!panel) { shadow.innerHTML = ''; return; }

  var html = '';
  panel.querySelectorAll('.tfc-tracker[data-tracker-id]').forEach(function(trackerEl) {
    var tid = trackerEl.dataset.trackerId;
    var applicable = (trackerEl.dataset.applicableProjects || '').split(',').filter(Boolean);
    if (!applicable.length) return;

    trackerEl.querySelectorAll('.tfc-bulkhide-checkbox:checked').forEach(function(cb) {
      var fieldKey = cb.dataset.fieldKey;
      applicable.forEach(function(pid) {
        html += '<input type="hidden" name="settings[project_tracker_hidden_fields][' + pid + '][' + tid + '][]" value="' + tfcHideEsc(fieldKey) + '">';
      });
    });
  });

  shadow.innerHTML = html;
}

function tfcBulkHideToggleTracker(tid) {
  var body  = document.getElementById('tfc-bulkhide-body-'  + tid);
  var arrow = document.getElementById('tfc-bulkhide-arrow-' + tid);
  if (!body) return;
  if (body.classList.contains('tfc-open')) {
    body.classList.remove('tfc-open');
    arrow.innerHTML = '&#9660;';
  } else {
    body.classList.add('tfc-open');
    arrow.innerHTML = '&#9650;';
  }
}

/* Registers a new "Other fields" entry (e.g. Agile Sprint) across every
   applicable checked project for one tracker, in bulk mode. Unlike the
   std_/cf_ checkboxes, this does NOT go through tfcBulkHideSync's
   rebuild-from-scratch pass - it writes real settings[...] inputs
   directly into the persistent #tfc-bulkhide-extra-additions container
   (a sibling of #tfc-bulkhide-panel, so refetching the panel on further
   tree changes can't wipe it), and registers + hides the field in one
   step, matching the single-project panel's "newly added = hidden by
   default" behavior. */
function tfcBulkHideAddExtra(tid, applicableIdsCsv) {
  var labelInput = document.getElementById('tfc-bulkhide-extra-label-' + tid);
  var keyInput = document.getElementById('tfc-bulkhide-extra-key-' + tid);
  var label = labelInput.value.trim();
  var keyRaw = keyInput.value.trim().replace(/^issue_/, '');

  if (!label || !keyRaw) {
    alert('Please enter both a label and an id.');
    return;
  }

  var pids = (applicableIdsCsv || '').split(',').filter(Boolean);
  if (!pids.length) {
    alert('No checked projects have this tracker.');
    return;
  }

  var groupId = 'tfc-bulkhide-addition-' + tid + '-' + keyRaw;
  if (document.getElementById(groupId)) {
    alert('That field was already added in this session.');
    return;
  }

  var additions = document.getElementById('tfc-bulkhide-extra-additions');
  var html = '<div id="' + tfcHideEsc(groupId) + '">';
  pids.forEach(function(pid) {
    html += '<input type="hidden" name="settings[project_tracker_extra_fields][' + pid + '][' + tid + '][]" value="' + tfcHideEsc(keyRaw) + '">';
    html += '<input type="hidden" name="settings[project_tracker_extra_field_labels][' + pid + '][' + tid + '][' + tfcHideEsc(keyRaw) + ']" value="' + tfcHideEsc(label) + '">';
    html += '<input type="hidden" name="settings[project_tracker_hidden_fields][' + pid + '][' + tid + '][]" value="ext_' + tfcHideEsc(keyRaw) + '">';
  });
  html += '</div>';
  additions.insertAdjacentHTML('beforeend', html);

  var extraBox = document.getElementById('tfc-bulkhide-extra-' + tid);
  if (extraBox) {
    var row = document.createElement('div');
    row.style.cssText = 'display:flex;align-items:center;gap:8px;font-size:12px;color:#2e7d32;margin-top:8px;';
    row.innerHTML = 'Added &amp; hidden "' + tfcHideEsc(label) + '" for ' + pids.length +
      ' project' + (pids.length === 1 ? '' : 's') + ' (takes effect after you save) ' +
      '<button type="button" class="tfc-add-btn" style="background:#9e9e9e;padding:2px 8px;font-size:11px;">Undo</button>';
    row.querySelector('button').addEventListener('click', function() {
      var group = document.getElementById(groupId);
      if (group) group.remove();
      row.remove();
    });
    extraBox.appendChild(row);
  }

  labelInput.value = '';
  keyInput.value = '';
}
</script>
